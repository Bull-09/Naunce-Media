{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(zebra-learn-blinkit-questionnaire|growth-audit|nm-admin).html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}
