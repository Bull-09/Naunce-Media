# For Apache / cPanel / Hostinger-style hosting. Ignored by Vercel and Netlify.
ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html

# Force HTTPS and the bare domain (nuancemedia.agency, no www)
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://nuancemedia.agency%{REQUEST_URI} [L,R=301]

# Cache images and video for a year, CSS/JS for a day
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>
